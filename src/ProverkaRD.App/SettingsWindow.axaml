<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProverkaRD.SettingsWindow"
        Title="Настройки"
        Icon="/Assets/rd.png"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Замечания" FontSize="16" FontWeight="SemiBold"/>
        <CheckBox x:Name="GroupDuplicatesBox" Content="Объединять одинаковые замечания в одну строку"/>
        <CheckBox x:Name="ReadZipBox" Content="Читать zip-архивы"/>
        <TextBlock TextWrapping="Wrap" Foreground="#5C6B7A"
                   Text="По умолчанию выключено: файл .zip не открывается. В сводке тогда есть строка «пропущено zip: N». Одинаковые PDF рядом и внутри архива всё равно читаются один раз, если чтение архива включено."/>
        <TextBlock TextWrapping="Wrap" Foreground="#5C6B7A"
                   Text="Игнорируемые подписанты не попадают в замечания о фамилии. По одному в строке. Сравнение по основе фамилии: «Павлову» и «Павлов» — один человек."/>
        <TextBox x:Name="IgnoredBox" AcceptsReturn="True" Height="120" TextWrapping="Wrap"/>
        <TextBlock Text="НДС, %" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="#5C6B7A"
                   Text="Ставка для сумм акта и пересчёта ВЭСР. С 2026 года в России — 22. Пустое поле или число вне 0–100 возвращает 22. Ноль сохраняется как 0%."/>
        <TextBox x:Name="VatBox" Width="120" HorizontalAlignment="Left"/>
        <CheckBox x:Name="UpdatesBox" Content="Проверять обновления при запуске"/>
        <Button Content="Принудительное обновление" Click="OnForceUpdate" HorizontalAlignment="Left"/>
        <Button Content="Открыть журнал" Click="OnOpenLog" HorizontalAlignment="Left"/>
        <TextBlock TextWrapping="Wrap" Foreground="#5C6B7A"
                   Text="Журнал лежит в %LOCALAPPDATA%\ProverkaRD\logs. Туда пишутся сбои и итог запуска: имена файлов, без текста документов."/>
        <TextBlock TextWrapping="Wrap" Foreground="#5C6B7A"
                   Text="Скачивает последний релиз и ставит его заново, даже если версия совпадает с установленной. Проверка SHA256 и замена файла — те же, что у обычного обновления."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="О программе" Click="OnAbout"/>
            <Button Classes="primary" Content="Закрыть" Click="OnClose" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
