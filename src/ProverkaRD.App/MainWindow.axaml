<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ProverkaRD"
        x:Class="ProverkaRD.MainWindow"
        x:CompileBindings="False"
        Title="РД Контроль"
        Icon="/Assets/rd.png"
        Width="1320" Height="880"
        MinWidth="980" MinHeight="680"
        Background="#F3F5F8">
    <Window.Resources>
        <local:MissingBrushConverter x:Key="MissingBrush"/>
        <local:SeverityTextConverter x:Key="SevText"/>
        <local:SeverityBrushConverter x:Key="SevBrush"/>
        <local:FailBrushConverter x:Key="FailBrush"/>
        <local:MoneyTextConverter x:Key="MoneyText"/>
        <local:StateBrushConverter x:Key="StateBrush"/>
        <DataTemplate x:Key="CheckNameCell"><local:WrappedCell Text="{Binding CheckName}"/></DataTemplate>
        <DataTemplate x:Key="InActCell"><local:WrappedCell Text="{Binding InAct}"/></DataTemplate>
        <DataTemplate x:Key="InRdCell"><local:WrappedCell Text="{Binding InRd}"/></DataTemplate>
        <DataTemplate x:Key="InVerdCell"><local:WrappedCell Text="{Binding InVerd}"/></DataTemplate>
        <DataTemplate x:Key="InVesrCell"><local:WrappedCell Text="{Binding InVesr}"/></DataTemplate>
        <DataTemplate x:Key="PlacesCell"><local:WrappedCell Text="{Binding Places}"/></DataTemplate>
        <DataTemplate x:Key="ErrorWhereCell"><local:WrappedCell Text="{Binding ErrorWhere}"/></DataTemplate>
        <DataTemplate x:Key="CompletenessCell"><local:WrappedCell Text="{Binding CompletenessText}"/></DataTemplate>
        <DataTemplate x:Key="SurnamesCell"><local:WrappedCell Text="{Binding Surnames}"/></DataTemplate>
        <DataTemplate x:Key="SignersCell"><local:WrappedCell Text="{Binding Signers}"/></DataTemplate>
        <DataTemplate x:Key="NoticeCell"><local:WrappedCell Text="{Binding Message}"/></DataTemplate>
        <DataTemplate x:Key="ExplanationCell"><local:WrappedCell Text="{Binding Explanation}"/></DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="TabControl">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1F4E79" Padding="22,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="White" ClipToBounds="True" VerticalAlignment="Center">
                        <Image Width="44" Height="44" Source="avares://ProverkaRD/Assets/rd.png"/>
                    </Border>
                    <TextBlock x:Name="ProductTitle" Text="РД Контроль" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Text="0.1.7" FontSize="16" Foreground="#D6E3F0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="onDark" Click="OnSettings" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚙" FontSize="18" Foreground="#1F4E79"/>
                        <TextBlock Text="Настройки" Foreground="#1F4E79" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="18,10" Background="{Binding StateKind, Converter={StaticResource StateBrush}}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding StateTitle}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ResultLine}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" IsVisible="{Binding HasResult}"/>
                <TextBlock Text="{Binding ResultDetails}" TextWrapping="Wrap" IsVisible="{Binding ShowCounters}"/>
                <TextBlock Text="{Binding StateDetail}" TextWrapping="Wrap" IsVisible="{Binding ShowStateDetail}"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressValue}" IsVisible="{Binding ShowProgress}" Height="8"/>
                <TextBlock Text="{Binding ProgressText}" IsVisible="{Binding ShowProgress}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="White" Padding="18,12" BorderBrush="#E2E7EE" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Background="#F7F9FC" BorderBrush="#D5DDE8" BorderThickness="1" CornerRadius="8" Padding="10,8"
                        DragDrop.AllowDrop="True" DragDrop.DragOver="OnExcelDragOver" DragDrop.Drop="OnVerdDrop">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Загрузить ВЭРД" Click="OnLoadVerd" IsEnabled="{Binding CanRun}"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Foreground="#5C6B7A" FontSize="12" Text="Перетащите сюда xlsx"/>
                            <TextBlock Text="{Binding VerdCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#F7F9FC" BorderBrush="#D5DDE8" BorderThickness="1" CornerRadius="8" Padding="10,8"
                        DragDrop.AllowDrop="True" DragDrop.DragOver="OnExcelDragOver" DragDrop.Drop="OnVesrDrop">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Загрузить ВЭСР" Click="OnLoadVesr" IsEnabled="{Binding CanRun}"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Foreground="#5C6B7A" FontSize="12" Text="Перетащите сюда xlsx"/>
                            <TextBlock Text="{Binding VesrCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E7EE" BorderThickness="0,1,0,0" Padding="18,10">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </Border>

        <Grid x:Name="InputSplit" Margin="16" RowDefinitions="240,8,*">
            <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E7EE" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Classes="listBar" Click="OnToggleLists"
                            HorizontalContentAlignment="Left" Padding="14,0"
                            Content="{Binding ListsCaption}"
                            ToolTip.Tip="Показать или скрыть акты и комплекты"/>
                    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding ListsOpen}" Spacing="8" Margin="12,8,12,0">
                        <Border Background="#F7F9FC" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Padding="10,6"
                                DragDrop.AllowDrop="True" DragDrop.DragOver="OnExcelDragOver" DragDrop.Drop="OnActDrop">
                            <Grid ColumnDefinitions="120,Auto,*,Auto">
                                <TextBlock Text="Акты" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="quiet" Content="Файлы" Click="OnAddActFiles" IsEnabled="{Binding CanRun}"/>
                                    <Button Classes="quiet" Content="Папка" Click="OnAddActFolder" IsEnabled="{Binding CanRun}"/>
                                    <Button Classes="quiet" Content="Очистить" Click="OnClearActs" IsEnabled="{Binding CanRun}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding ActCountText}" VerticalAlignment="Center" Foreground="#5C6B7A"/>
                            </Grid>
                        </Border>
                        <Border Background="#F7F9FC" BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8" Padding="10,6"
                                DragDrop.AllowDrop="True" DragDrop.DragOver="OnExcelDragOver" DragDrop.Drop="OnRdDrop">
                            <Grid ColumnDefinitions="120,Auto,*,Auto">
                                <TextBlock Text="Комплекты РД" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="quiet" Content="Файлы" Click="OnAddRdFiles" IsEnabled="{Binding CanRun}"/>
                                    <Button Classes="quiet" Content="Папка" Click="OnAddRdFolder" IsEnabled="{Binding CanRun}"/>
                                    <Button Classes="quiet" Content="Очистить" Click="OnClearRd" IsEnabled="{Binding CanRun}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding RdCountText}" VerticalAlignment="Center" Foreground="#5C6B7A"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding OutlineSummary}" FontWeight="SemiBold" Foreground="#1F4E79" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Panel IsVisible="{Binding ListsOpen}" Margin="8,4,8,8">
                        <TreeView x:Name="InputTree" ItemsSource="{Binding InputNodes}" ContextRequested="OnInputContext">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding Expand}"/>
                                </Style>
                            </TreeView.Styles>
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="local:InputNode" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Mark}" FontWeight="Bold" Foreground="#15803D" Width="16"/>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                   Foreground="{Binding Problem, Converter={StaticResource MissingBrush}}"/>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                        <TextBlock IsVisible="{Binding OutlineEmpty}" IsHitTestVisible="False" Margin="8" Foreground="#7A8794"
                                   Text="Перетащите акты и комплекты на строки выше."/>
                    </Panel>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" Background="#D5DDE8" IsVisible="{Binding ListsOpen}"/>
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox PlaceholderText="Фильтр по акту, шифру или тексту" Text="{Binding FilterText}" Width="320" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Выгрузить отчёт (Excel)" Click="OnExport" IsEnabled="{Binding CanExport}" VerticalAlignment="Center"/>
                        <Button Classes="accent" Content="Проверить" Click="OnCheck" IsEnabled="{Binding CanRun}"/>
                    </StackPanel>
                </Grid>
                <TabControl Grid.Row="1" Margin="0,8,0,0">
                    <TabItem Header="Акты">
                        <Grid x:Name="ActSplit" RowDefinitions="*,0,0">
                            <DataGrid Grid.Row="0" ItemsSource="{Binding FilteredActs}" SelectedItem="{Binding SelectedAct, Mode=TwoWay}"
                                      IsReadOnly="True" CanUserSortColumns="True"
                                      GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="10" CanUserResize="False" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Overall, Converter={StaticResource SevBrush}}" Width="6" HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="150" SortMemberPath="Overall">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Итог" VerticalAlignment="Center"/>
                                                <Button Content="▾" Padding="4,0" Tag="act-overall" Click="OnFilterColumn" Background="Transparent"/>
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Overall, Converter={StaticResource SevBrush}}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Overall, Converter={StaticResource SevText}}" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding ElementNo}" Width="110" SortMemberPath="ElementNo">
                                        <DataGridTextColumn.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Элемент" VerticalAlignment="Center"/>
                                                <Button Content="▾" Padding="4,0" Tag="act-element" Click="OnFilterColumn" Background="Transparent"/>
                                            </StackPanel>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Критично" Binding="{Binding CriticalCount}" Width="90"/>
                                    <DataGridTextColumn Header="Оформление" Binding="{Binding FormattingCount}" Width="110"/>
                                    <DataGridTextColumn Header="Предупреждения" Binding="{Binding WarningCount}" Width="140"/>
                                    <DataGridTextColumn Header="Акт" Binding="{Binding FileName}" Width="280"/>
                                    <DataGridTemplateColumn Header="Наименование" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding NameStatus}" Tip="{Binding NameTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Стоимость, имя" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding CostNameStatus}" Tip="{Binding CostNameTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Код ДГП" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding CodeStatus}" Tip="{Binding CodeTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Без НДС, акт" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding NetStatus, Converter={StaticResource FailBrush}}" Padding="6,2">
                                                    <TextBlock Text="{Binding ActNet, Converter={StaticResource MoneyText}}" HorizontalAlignment="Right"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Без НДС, ВЭСР" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding NetStatus, Converter={StaticResource FailBrush}}" Padding="6,2">
                                                    <TextBlock Text="{Binding VesrNet, Converter={StaticResource MoneyText}}" HorizontalAlignment="Right"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Без НДС" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding NetStatus}" Tip="{Binding NetTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="С НДС" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding GrossStatus}" Tip="{Binding GrossTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="НДС" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding VatStatus}" Tip="{Binding VatTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Цена за единицу" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding UnitPriceStatus}" Tip="{Binding UnitTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Комплектность" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <local:CheckCell Status="{Binding CompletenessStatus}" Tip="{Binding CompletenessTip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Состав" Width="280" MinWidth="140" SortMemberPath="CompletenessText" CellTemplate="{StaticResource CompletenessCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          ResizeDirection="Rows" Background="#D5DDE8" IsVisible="{Binding HasSelectedAct}"/>
                            <Border Grid.Row="2" IsVisible="{Binding HasSelectedAct}" Padding="10" Background="White"
                                    BorderBrush="#E2E7EE" BorderThickness="1" CornerRadius="8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedActTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedKitsText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock DockPanel.Dock="Top" IsVisible="{Binding SelectedRemarksEmpty}" Foreground="#5C6B7A"
                                               Text="Замечаний по этому акту нет."/>
                                    <DataGrid ItemsSource="{Binding SelectedRemarks}" IsReadOnly="True" CanUserSortColumns="True"
                                              GridLinesVisibility="Horizontal" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="8" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" Width="6" HorizontalAlignment="Left"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Критичность" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Severity, Converter={StaticResource SevText}}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Что проверялось" Width="*" MinWidth="140" SortMemberPath="CheckName" CellTemplate="{StaticResource CheckNameCell}"/>
                                            <DataGridTemplateColumn Header="Пояснение" Width="*" MinWidth="160" SortMemberPath="Explanation" CellTemplate="{StaticResource ExplanationCell}"/>
                                            <DataGridTemplateColumn Header="В акте" Width="160" MinWidth="96" SortMemberPath="InAct" CellTemplate="{StaticResource InActCell}"/>
                                            <DataGridTemplateColumn Header="В РД" Width="120" MinWidth="80" SortMemberPath="InRd" CellTemplate="{StaticResource InRdCell}"/>
                                            <DataGridTemplateColumn Header="В ВЭРД" Width="160" MinWidth="96" SortMemberPath="InVerd" CellTemplate="{StaticResource InVerdCell}"/>
                                            <DataGridTemplateColumn Header="В ВЭСР" Width="96" MinWidth="72" SortMemberPath="InVesr" CellTemplate="{StaticResource InVesrCell}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Комплекты">
                        <DataGrid ItemsSource="{Binding FilteredKits}" IsReadOnly="True" CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="10" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Overall, Converter={StaticResource SevBrush}}" Width="6" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="150" SortMemberPath="Overall">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Итог" VerticalAlignment="Center"/>
                                            <Button Content="▾" Padding="4,0" Tag="kit-overall" Click="OnFilterColumn" Background="Transparent"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Overall, Converter={StaticResource SevBrush}}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Overall, Converter={StaticResource SevText}}" FontWeight="SemiBold" Foreground="#1F2937"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding ElementNo}" Width="110" SortMemberPath="ElementNo">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Элемент" VerticalAlignment="Center"/>
                                            <Button Content="▾" Padding="4,0" Tag="kit-element" Click="OnFilterColumn" Background="Transparent"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Шифр" Binding="{Binding Cipher}" Width="240"/>
                                <DataGridTextColumn Header="Акт" Binding="{Binding ActName}" Width="220"/>
                                <DataGridTemplateColumn Header="Наименование" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:CheckCell Status="{Binding NameStatus}" Tip="{Binding NameTip}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Файл" Binding="{Binding Presence}" Width="160"/>
                                <DataGridTemplateColumn Header="Элемент РД" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:CheckCell Status="{Binding RdElementStatus}" Tip="{Binding ElementTip}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Фамилии" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:CheckCell Status="{Binding SurnameStatus}" Tip="{Binding SurnameTip}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="В документе" Width="220" MinWidth="120" SortMemberPath="Surnames" CellTemplate="{StaticResource SurnamesCell}"/>
                                <DataGridTemplateColumn Header="Подписанты" Width="220" MinWidth="120" SortMemberPath="Signers" CellTemplate="{StaticResource SignersCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Замечания">
                        <DataGrid ItemsSource="{Binding FilteredFindings}" IsReadOnly="True" CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="10" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" Width="6" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding ElementNo}" Width="110" SortMemberPath="ElementNo">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Элемент" VerticalAlignment="Center"/>
                                            <Button Content="▾" Padding="4,0" Tag="finding-element" Click="OnFilterColumn" Background="Transparent"/>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Критичность" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource SevText}}" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Что проверялось" Width="170" MinWidth="140" SortMemberPath="CheckName" CellTemplate="{StaticResource CheckNameCell}"/>
                                <DataGridTemplateColumn Header="В акте" Width="150" MinWidth="96" SortMemberPath="InAct" CellTemplate="{StaticResource InActCell}"/>
                                <DataGridTemplateColumn Header="В РД" Width="120" MinWidth="80" SortMemberPath="InRd" CellTemplate="{StaticResource InRdCell}"/>
                                <DataGridTemplateColumn Header="В ВЭРД" Width="150" MinWidth="96" SortMemberPath="InVerd" CellTemplate="{StaticResource InVerdCell}"/>
                                <DataGridTemplateColumn Header="В ВЭСР" Width="96" MinWidth="72" SortMemberPath="InVesr" CellTemplate="{StaticResource InVesrCell}"/>
                                <DataGridTemplateColumn Header="Где" Width="*" MinWidth="150" SortMemberPath="Places" CellTemplate="{StaticResource PlacesCell}"/>
                                <DataGridTemplateColumn Width="*" MinWidth="180" SortMemberPath="ErrorWhere" CellTemplate="{StaticResource ErrorWhereCell}">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Где ошибка" VerticalAlignment="Center"/>
                                            <Button Content="▾" Padding="4,0" Tag="finding-where" Click="OnFilterColumn" Background="Transparent"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Пропуски">
                        <DataGrid ItemsSource="{Binding FilteredNotices}" IsReadOnly="True" CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="120"/>
                                <DataGridTextColumn Header="Место" Binding="{Binding Place}" Width="160" MinWidth="100"/>
                                <DataGridTemplateColumn Header="Сообщение" Width="*" MinWidth="240" SortMemberPath="Message" CellTemplate="{StaticResource NoticeCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
